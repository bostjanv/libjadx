  "source": "package probe;\n\n/* JADX INFO: loaded from: variables.jar:probe/Variables.class */\npublic class Variables {\n    public int field;\n\n    public int instance(int i, long j, double d, String str) {\n        int i2 = i + ((int) j);\n        int length = str.length() + ((int) d);\n        if (i2 > length) {\n            this.field = i2 * 2;\n        } else {\n            this.field = length * 3;\n        }\n        for (int i3 = 0; i3 < i; i3++) {\n            i2 += i3;\n        }\n        return i2 + length + this.field;\n    }\n\n    public static long statik(long j, int i, double d) {\n        return j + ((long) i) + ((long) d);\n    }\n\n    public int single(int i) {\n        return i + this.field;\n    }\n\n    public String single(String str) {\n        return str + this.field;\n    }\n\n    @Deprecated\n    public int annotated(@Deprecated int i) {\n        return i + this.field;\n    }\n\n    public <T> T generic(T t) {\n        return t;\n    }\n\n    public int zero() {\n        return this.field;\n    }\n\n    public int merged(int i) {\n        int i2 = i > 0 ? i + 1 : i - 1;\n        for (int i3 = 0; i3 < 3; i3++) {\n            i2 += i3;\n        }\n        return i2;\n    }\n\n    public int temporary(int i) {\n        return (i + 2) * (i + 3);\n    }\n}",
